# Copy to .env (git-ignored). Non-secret settings only.
# Models: "anthropic:<id>" calls the Anthropic API (key: SOC_ANTHROPIC_API_KEY in ~/.anthropic_env);
# "openrouter:<id>" calls OpenRouter (key: OPENROUTER_API_KEY in the environment or ~/.openrouter_env).
TRIAGE_MODEL=anthropic:claude-haiku-5-5
INVESTIGATE_MODEL=anthropic:claude-sonnet-5-5
# Natural-language search in the console / CLI
ASK_MODEL=anthropic:claude-sonnet-5-5
# Alerts at or above this level reach the agents
MIN_LEVEL=7
# Wazuh indexer: reached through an SSH tunnel to 127.0.0.1:9200 on the wazuh VM
WAZUH_SSH=soc@10.10.10.10
LAB_SSH_KEY=~/.ssh/tiny-soc_ed25519
INDEXER_CREDS_FILE=lab/.secrets/soc-agent-indexer.txt
# Linked from the console header, and the upstream the gateway proxies (reachable from WSL)
WAZUH_DASHBOARD_URL=https://10.10.10.10
