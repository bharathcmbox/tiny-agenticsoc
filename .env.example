# Copy to .env (git-ignored). Non-secret settings only.
# The OpenRouter key is read from the environment (OPENROUTER_API_KEY) or ~/.openrouter_env.
TRIAGE_MODEL=anthropic/claude-haiku-5.5
INVESTIGATE_MODEL=anthropic/claude-sonnet-5.5
# Alerts at or above this level reach the agents
MIN_LEVEL=7
# Wazuh indexer: reached through an SSH tunnel to 127.0.0.1:9200 on the wazuh VM
WAZUH_SSH=soc@10.10.10.10
LAB_SSH_KEY=~/.ssh/tiny-soc_ed25519
INDEXER_CREDS_FILE=lab/.secrets/soc-agent-indexer.txt
