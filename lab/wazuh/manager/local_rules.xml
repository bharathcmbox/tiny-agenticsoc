<!-- tiny-agenticsoc local rules (ids 100000-100999). Deployed to /var/ossec/etc/rules/local_rules.xml -->
<group name="zeek,">
  <!-- Base: any Zeek JSON event shipped from the sensor (label zeek.log). Level 0 = archived, not alerted. -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="zeek.log">\.+</field>
    <description>Zeek $(zeek.log) event</description>
  </rule>

  <rule id="100101" level="8">
    <if_sid>100100</if_sid>
    <field name="zeek.log">^notice$</field>
    <description>Zeek notice: $(note) - $(msg)</description>
    <group>zeek_notice,</group>
  </rule>

  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <field name="zeek.log">^weird$</field>
    <field name="name" negate="yes">dns_unmatched_reply|bad_TCP_checksum|possible_split_routing</field>
    <description>Zeek weird: $(name)</description>
    <group>zeek_weird,</group>
  </rule>
</group>
