#cloud-config
# wazuh: base OS only. Wazuh itself is installed in Phase 1 (docs/phase1-telemetry.md)
# so you see and keep the generated admin credentials.
hostname: wazuh
fqdn: wazuh.${LAB_DOMAIN}
users:
  - name: soc
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: false
    passwd: "${LAB_PASSWD_HASH}"
    ssh_authorized_keys: ["${LAB_SSH_PUBKEY}"]
ssh_pwauth: false
timezone: UTC
package_update: true
packages: [curl, jq, gnupg, apt-transport-https]
write_files:
  - path: /etc/sysctl.d/90-wazuh-indexer.conf
    content: |
      vm.max_map_count=262144
runcmd:
  - sysctl --system
final_message: "wazuh base ready after $UPTIME s"
