# tiny-agenticsoc lab configuration - single source of truth.
# Read by lab/images/build-images.sh (bash) and lab/hyperv/*.ps1 (PowerShell).
# Format: KEY=VALUE, no spaces around '=', no quotes.

# Where Hyper-V artifacts live on the Windows side (and the same path from WSL)
LAB_WIN_DIR=C:\HyperV\tiny-soc
LAB_WIN_DIR_WSL=/mnt/c/HyperV/tiny-soc

# Ubuntu cloud image
LAB_UBUNTU_RELEASE=noble
LAB_UBUNTU_IMG_URL=https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img
LAB_UBUNTU_SUMS_URL=https://cloud-images.ubuntu.com/noble/current/SHA256SUMS

# Lab network (Hyper-V internal switch)
LAB_SWITCH=LabNet
LAB_WAN_SWITCH=Default Switch
LAB_SUBNET=10.10.10.0/24
LAB_PREFIX=24
LAB_DOMAIN=lab.local
LAB_HOST_IP=10.10.10.254
LAB_GW_IP=10.10.10.1
LAB_WAZUH_IP=10.10.10.10
LAB_WIN_IP=10.10.10.20
LAB_LIN_IP=10.10.10.21
LAB_DHCP_START=10.10.10.100
LAB_DHCP_END=10.10.10.150

# Static MACs (Hyper-V OUI 00:15:5D) - cloud-init matches NICs by these
LAB_GW_WAN_MAC=00:15:5d:0a:0a:01
LAB_GW_LAN_MAC=00:15:5d:0a:0a:02
LAB_GW_MON_MAC=00:15:5d:0a:0a:03
LAB_WAZUH_MAC=00:15:5d:0a:0a:10
LAB_WIN_MAC=00:15:5d:0a:0a:20
LAB_LIN_MAC=00:15:5d:0a:0a:21

# VM sizing (MB / GB). *_MEM_MB is startup RAM. If *_MEM_MAX_MB is set the VM uses
# Hyper-V dynamic memory (grows from startup to max on demand); otherwise RAM is static.
LAB_GW_CPU=2
LAB_GW_MEM_MB=2048
LAB_GW_DISK_GB=30
LAB_WAZUH_CPU=4
LAB_WAZUH_MEM_MB=6144
LAB_WAZUH_DISK_GB=60
LAB_WIN_CPU=2
LAB_WIN_MEM_MB=2048
LAB_WIN_MEM_MAX_MB=4096
LAB_WIN_DISK_GB=64
LAB_LIN_CPU=1
LAB_LIN_MEM_MB=1024
LAB_LIN_MEM_MAX_MB=1536
LAB_LIN_DISK_GB=20

# Versions
LAB_WAZUH_SERIES=4.14
LAB_ZEEK_PKG=zeek-lts
